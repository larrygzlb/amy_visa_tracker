# Copy to .env and fill in. On GitHub Actions, add each of these as a repository secret instead.
API_KEY_2CAPTCHA=your-2captcha-key
# Comma-separated WxPusher SPTs (max 10); leave empty for no notifications
WXPUSHER_SPTS=SPT_xxx,SPT_yyy
# Full VFS passport tracking URL, including the "?q=..." part
VFS_URL=https://visatracking.vfsglobal.com/Global-Passporttracking/Track/Index?q=...
VFS_REFERENCE=VFSCTU0000000
LAST_NAME=YourLastName
EMBASSY=Beijing (Pékin)
# Comma-separated field:value pairs; field is visumnr or refnum
INFOVISA_QUERIES=visumnr:BEL0000...,refnum:VFSCTU0000000
